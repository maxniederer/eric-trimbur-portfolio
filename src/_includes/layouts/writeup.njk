---
layout: layouts/base.njk
---

<div class="writeup-holder max-width">
  <div>
    {% if content | toc %}
    <aside>
      <h2>Contents</h2>
      {{ content | toc | safe }}
    </aside>
    {% endif %}
  </div>
  <div class="writeup">
    <h1>{{title}}</h1>
    {% if tags.includes("blog") %}
      <p class="italics">{{date | postDate}}</p>
    {% else %}
      <p class="italics">{{year}}</p>
    {% endif %}
    {{ content | safe }}
    {% if tags.includes("blog") %}
      <a href="/#blogs" class="btn">Back to my blogs</a>
    {% else %}
      <a href="/#projects" class="btn">Back to my projects</a>
    {% endif %}
  </div>
</div>
