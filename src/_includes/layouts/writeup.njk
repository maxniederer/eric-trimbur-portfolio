---
layout: layouts/base.njk
---

<write-up>
  <h1>{{title}}</h1>

  {% if tags.includes("blog") %}
    {% set myDate = date | postDate %}
  {% else %}
    {% set myDate = year %}
  {% endif %}
  <p>{{myDate}} — {{ content | timeToRead }} read</p>
  
  {% if content | toc %}
  <aside>
    <details>
      <summary>Table of Contents</summary>
      {{ content | toc | safe }}
    </details>
  </aside>
  {% endif %}

  {{ content | safe }}
  
  {% if tags.includes("blog") %}
  {% set type = "blogs" %}
  {% else %}
  {% set type = "projects" %}
  {% endif %}
  <a href="/#{{type}}" class="btn">Back to my {{type}}</a>
</write-up>
