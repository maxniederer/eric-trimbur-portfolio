---
layout: layouts/base.njk
---

<div class="writeup-holder max-width">
  <div>
    {% if content | toc %}
    <aside>
      <h2>Contents</h2>
      {{ content | toc | safe }}
    </aside>
    {% endif %}
  </div>
  <div class="writeup">
    <h1>{{title}}</h1>
    <p class="italics">{{year}}</p>
    {{ content | safe }}
    <a href="/#projects" class="btn">Back to my projects</a>
  </div>
</div>
